// MoodFlix — Prisma schema (SQLite for development, Postgres-ready structure)
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/* ------------------------------ Auth ------------------------------ */

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  passwordHash  String?
  image         String?
  emailVerified DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts             Account[]
  sessions             Session[]
  preferences          UserPreference?
  watchlist            WatchlistItem[]
  watched              WatchedMovie[]
  recommendationSessions RecommendationSession[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

/* --------------------------- Movie cache --------------------------- */
// `externalId` is the stable TMDB movie id (or our local sample id like "mf-1").
// Stored so the same movie is never recommended twice in one session and
// watchlists remain stable across re-syncs.

model Movie {
  id            String   @id @default(cuid())
  externalId    String   @unique
  title         String
  overview      String
  releaseDate   DateTime?
  runtime       Int
  genres        Json     // string[], e.g. ["Science Fiction","Drama"]
  language      String   // original_language code, e.g. "en"
  languageName  String   // human readable, e.g. "English"
  certification String?  // content rating, e.g. "PG-13"
  voteAverage   Float    // 0-10
  voteCount     Int
  posterPath    String?  // remote poster path if TMDB available
  backdropPath  String?  // remote backdrop path if TMDB available
  director      String?
  cast          Json     // string[]
  trailerUrl    String?
  moodTags      Json     // string[] (keys from MOOD_MAP)
  emotionalTone Json     // string[] (tones from MOOD_MAP)
  similarIds    Json     // string[] external ids
  tags          Json     // string[] e.g. ["sequel","classic","indie"]
  isLocal       Boolean  @default(true) // true = sample data, false = TMDB
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  watchlistItems       WatchlistItem[]
  watchedMovies        WatchedMovie[]
  recommendationResults RecommendationResult[]
}

/* ------------------------ User preferences ------------------------ */

model UserPreference {
  id           String   @id @default(cuid())
  userId       String   @unique
  genres       Json     // string[]
  languages    Json     // string[]
  minRating    Float    @default(0)
  maxRuntime   Int?
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/* ----------------------------- Watchlist ---------------------------- */

model WatchlistItem {
  id        String   @id @default(cuid())
  userId    String
  movieId   String
  addedAt   DateTime @default(now())

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  movie Movie  @relation(fields: [movieId], references: [id], onDelete: Cascade)

  @@unique([userId, movieId])
  @@index([userId])
}

/* --------------------------- Watched list --------------------------- */

model WatchedMovie {
  id         String   @id @default(cuid())
  userId     String
  movieId    String
  watchedAt  DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  movie Movie @relation(fields: [movieId], references: [id], onDelete: Cascade)

  @@unique([userId, movieId])
  @@index([userId])
}

/* --------------------- Saved recommendation sessions ---------------- */

model RecommendationSession {
  id        String   @id @default(cuid())
  userId    String
  answers   Json     // full QuestionnaireAnswers object
  createdAt DateTime @default(now())

  user    User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  results RecommendationResult[]

  @@index([userId])
}

model RecommendationResult {
  id        String   @id @default(cuid())
  sessionId String
  movieId   String
  rank      Int
  score     Float
  breakdown Json     // per-criteria score breakdown
  explanation String

  session RecommendationSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  movie   Movie                 @relation(fields: [movieId], references: [id], onDelete: Cascade)

  @@index([sessionId])
}
